# Sanity + Astro (local)

SANITY_PROJECT_ID=7jggn04g
SANITY_DATASET=production

# Optional read token (needed if dataset is private)
SANITY_API_READ_TOKEN=

# Write token — local seed only; never commit; never add to Cloudflare
SANITY_API_WRITE_TOKEN=

# Studio (also copy to studio/.env)
SANITY_STUDIO_PROJECT_ID=7jggn04g
SANITY_STUDIO_DATASET=production
