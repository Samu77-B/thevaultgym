---
// Logo-only holding page — full site routes redirect to / via public/_redirects
---
<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>The Vault Gym</title>
    <link rel="icon" type="image/png" href="/images/favicon.png" />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }
      html,
      body {
        height: 100%;
        background: #000;
      }
      body {
        display: flex;
        align-items: center;
        justify-content: center;
        min-height: 100vh;
      }
      .landing-logo {
        width: min(40vw, 215px);
        height: auto;
        display: block;
      }
    </style>
  </head>
  <body>
    <img
      src="/images/vaultgymLogo.svg"
      alt="The Vault Gym"
      class="landing-logo"
      width="215"
      height="215"
    />
  </body>
</html>
